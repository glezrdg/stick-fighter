# Copy to .env (gitignored) and fill values for local dev.

# Postgres password (also referenced by docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me-in-prod

# Local dev DB URL (matches `pnpm db:migrate` and dev server)
DATABASE_URL=postgres://stick:change-me-in-prod@localhost:5432/stick_fighter

# CORS — comma-separated list of allowed Origin headers
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://stick-fighter.vercel.app

# Bumped on each deploy for /health version field
API_VERSION=0.1.0

# Drizzle query log (1 = enable)
DRIZZLE_LOG=0
